{
    "name": "aihub",
    "main": "src/app.js",
    "compatibility_date": "2026-05-11",
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
        "logs": {
            "enabled": true,
            "invocation_logs": true
        }
    },
    "assets": {
        "directory": "./web/dist/",
        "binding": "assets"
    },
    "build": {
        "command": "npm install && cd web && npm install && npm run build"
    }
}
